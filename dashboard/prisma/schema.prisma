generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Game {
  id          String   @id @default(cuid())
  name        String   @unique
  universeId  BigInt   @unique
  placeId     BigInt   @unique
  thumb       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  scripts     Script[]
  executions  Execution[]
  createdAt   DateTime @default(now())
}
model Script {
  id              String   @id @default(cuid())
  gameId          String
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name            String
  version         String   @default("1.0.0")
  code            String   @db.Text
  // Clean source above is owner-only. The loader is served obfuscatedCode.
  obfuscatedCode    String?  @db.Text
  obfuscationStatus String   @default("none") // none|processing|ready|failed|unconfigured
  obfuscationError  String?
  obfuscatedAt      DateTime?
  isActive        Boolean  @default(true)
  executionsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  executions      Execution[]
  @@index([gameId, isActive])
}
model Execution {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  scriptId  String?
  script    Script?  @relation(fields: [scriptId], references: [id])
  placeId   BigInt?
  userId    String?
  username  String?
  executor  String?
  ip        String?
  country   String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  // Key that authorized this run (null = pre-key-system runs). Used to
  // detect sharing: one key + many userIds = revoke candidate.
  licenseKeyId String?
  licenseKey   LicenseKey? @relation(fields: [licenseKeyId], references: [id], onDelete: SetNull)
  @@index([gameId, createdAt])
  @@index([createdAt])
  @@index([licenseKeyId])
}
model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  lastUsed  DateTime?
  createdAt DateTime @default(now())
}

// License keys gate payload delivery. Enforcement lives server-side
// (GET /api/scripts requires a valid key+HWID) — any check inside Lua
// is UX only, since the attacker owns the executor.
model LicenseKey {
  id             String    @id @default(cuid())
  key            String    @unique
  note           String?
  hwid           String?   // bound machine; null until first use
  expiresAt      DateTime?
  maxExecutions  Int?      // null = unlimited
  executionsUsed Int       @default(0)
  isActive       Boolean   @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  executions     Execution[]
  @@index([key, isActive])
}
